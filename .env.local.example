DJANGO_DATABASE_PROFILE=local
LOCAL_DB_NAME=django_db_name
LOCAL_DB_USER=django_user
LOCAL_DB_PASSWORD=replace-with-local-mysql-password
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3308

# Use the values from the Midtrans Sandbox dashboard; the key prefix can vary.
MIDTRANS_SANDBOX_SERVER_KEY=replace-with-sandbox-server-key
MIDTRANS_SANDBOX_CLIENT_KEY=replace-with-sandbox-client-key
MIDTRANS_IS_PRODUCTION=False

# Copy the existing Fernet key; do not replace it when encrypted KTP data exists.
TITIP_JUAL_KTP_ENCRYPTION_KEY=copy-existing-key-here
